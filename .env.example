# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# auto uses the model when configured and degrades visibly on failure.
# live requires model success; offline runs deterministic checks only.
COPILOT_MODE=auto
MODEL_PROVIDER=groq
MODEL_NAME=openai/gpt-oss-120b
GROQ_API_KEY=
# Optional providers below. Only configure the selected provider's key.
OPENAI_API_KEY=
# For Gemini: MODEL_PROVIDER=gemini, MODEL_NAME=gemini-2.5-flash
GOOGLE_API_KEY=
# For Ollama: MODEL_PROVIDER=ollama, MODEL_NAME=qwen2.5:7b
